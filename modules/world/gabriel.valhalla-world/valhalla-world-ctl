#!/usr/bin/env bash
set -euo pipefail

PLUGIN_DIR="$HOME/.config/omarchy/plugins/gabriel.valhalla-world"
WEATHER_FILE="$PLUGIN_DIR/weather.json"

cmd="${1:-status}"
arg="${2:-}"

write_state() {
  local json="$1"
  printf '%s\n' "$json" > "${WEATHER_FILE}.tmp"
  mv "${WEATHER_FILE}.tmp" "$WEATHER_FILE"
}

case "$cmd" in
  preset)
    case "$arg" in
      rain|lluvia)
        write_state '{
  "enabled": true,
  "source": "preset",
  "condition": "rain",
  "rainIntensity": 0.85,
  "snowIntensity": 0.0,
  "windSpeed": 1.25,
  "fogDensity": 0.45,
  "thunderFrequency": 0.35,
  "auroraIntensity": 0.85,
  "temperatureC": 6,
  "location": "Kattegat · Lluvia Nórdica"
}'
        ;;
      storm|tormenta)
        write_state '{
  "enabled": true,
  "source": "preset",
  "condition": "thunderstorm",
  "rainIntensity": 1.0,
  "snowIntensity": 0.0,
  "windSpeed": 2.1,
  "fogDensity": 0.65,
  "thunderFrequency": 0.9,
  "auroraIntensity": 0.6,
  "temperatureC": 4,
  "location": "Midgard · Tormenta de Thor"
}'
        ;;
      snow|nieve)
        write_state '{
  "enabled": true,
  "source": "preset",
  "condition": "snow",
  "rainIntensity": 0.0,
  "snowIntensity": 0.9,
  "windSpeed": 0.8,
  "fogDensity": 0.55,
  "thunderFrequency": 0.0,
  "auroraIntensity": 0.95,
  "temperatureC": -5,
  "location": "Jotunheim · Ventisca"
}'
        ;;
      clear|aurora)
        write_state '{
  "enabled": true,
  "source": "preset",
  "condition": "clear",
  "rainIntensity": 0.0,
  "snowIntensity": 0.0,
  "windSpeed": 0.35,
  "fogDensity": 0.15,
  "thunderFrequency": 0.0,
  "auroraIntensity": 1.0,
  "temperatureC": 9,
  "location": "Asgard · Noche de Aurora"
}'
        ;;
      *)
        echo "Uso: $0 preset {rain|storm|snow|clear}" >&2
        exit 1
        ;;
    esac
    ;;
  toggle)
    if grep -q '"enabled":[[:space:]]*false' "$WEATHER_FILE" 2>/dev/null; then
      sed -i 's/"enabled":[[:space:]]*false/"enabled": true/' "$WEATHER_FILE"
    else
      sed -i 's/"enabled":[[:space:]]*true/"enabled": false/' "$WEATHER_FILE"
    fi
    ;;
  api-json)
    # Ready for external weather API scripts to push normalized JSON directly
    write_state "$arg"
    ;;
  status)
    cat "$WEATHER_FILE"
    ;;
  *)
    echo "Uso: $0 {preset <rain|storm|snow|clear>|toggle|api-json <json>|status}" >&2
    exit 1
    ;;
esac
