{
  "version": 1,
  "idle": {
    "screensaver": 604800,
    "lock": 300
  },
  "bar": {
    "id": "gabriel.bar",
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "gabriel.menu"
        },
        {
          "id": "gabriel.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.clock",
          "format": "'◆'  dddd HH:mm  '◆'",
          "formatAlt": "'◆'  d MMMM 'W'ww yyyy  '◆'",
          "verticalFormat": "HH\n'◆'\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "claude-pet",
          "type": "qml"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "tenzin.live-wallpaper"
    },
    {
      "id": "gabriel.valhalla-world"
    }
  ],
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "gabriel.menu"
  ]
}
