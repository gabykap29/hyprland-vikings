{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "color": {"1": "#4ecdc4", "2": "#d49b4b"},
        "source": "~/.config/fastfetch/ascii/valhalla.txt",
        "padding": {
            "top": 1,
            "right": 5
        }
    },
    "display": {
        "color": {"keys": "#d49b4b", "title": "#4ecdc4"},
        "separator": "  "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[1;33mᛟ  VALHALLA · CLAN DEL CUERVO  ᛟ\u001b[0m"
        },
        {
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "format": "{name} (Midgard)",
            "key": "ᛟ "
        },
        {
            "type": "wm",
            "format": "{process-name} · Hyprland",
            "key": "⚔ "
        },
        {
            "type": "uptime",
            "format": "{hours}h {minutes}m en incursión",
            "key": "⏳"
        },
        {
            "type": "packages",
            "format": "{} runas forjadas",
            "key": "🛡 "
        },
        {
            "type": "cpu",
            "format": "{name}",
            "key": "⚡"
        },
        {
            "type": "gpu",
            "format": "{name}",
            "key": "🔥"
        },
        {
            "type": "memory",
            "key": "🏺"
        },
        {
            "type": "media",
            "key": "📯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[36m«Mejor luchar y caer que vivir sin esperanza.» — Volsunga Saga\u001b[0m"
        },
        {
            "key": "ᚠ ",
            "type": "colors",
            "symbol": "diamond"
        },
        "break"
    ]
}
